{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Average anomaly by decade (2020s covers 2020-2023 only)",
  "width": "container",
  "height": 280,
  "autosize": {"type": "fit", "contains": "padding"},
  "data": {"url": "data.json"},
  "transform": [
    {"calculate": "floor(datum.year / 10) * 10 + 's'", "as": "decade"}
  ],
  "mark": "bar",
  "encoding": {
    "x": {"field": "decade", "type": "nominal", "title": "Decade", "sort": "ascending", "axis": {"labelAngle": 0}},
    "y": {"field": "anomaly", "aggregate": "mean", "type": "quantitative", "title": "Mean anomaly"},
    "color": {
      "field": "anomaly",
      "aggregate": "mean",
      "type": "quantitative",
      "legend": null,
      "scale": {"scheme": "oranges"}
    },
    "tooltip": [
      {"field": "decade", "type": "nominal", "title": "Decade"},
      {"field": "anomaly", "aggregate": "mean", "type": "quantitative", "title": "Mean anomaly", "format": ".3f"}
    ]
  }
}
